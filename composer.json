{
    "name": "dasprid/vnstat-php",
    "description": "A PHP frontend for vnStat network traffic statistics",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Vnstat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vnstat\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
